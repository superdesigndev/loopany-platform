#!/usr/bin/env bash
# `loopany-dev` — the REWRITE (kernel) CLI, pinned to a LOCAL dev stack.
#
# ============================================================================
# PLATFORM DEVELOPMENT ONLY, IN THIS FORM.
#
# This in-repo copy runs the repo's CLI and, when LOOPANY_SERVER_URL is unset,
# SOURCES scripts/rewrite-local-run.env.sh — which stands up a separate isolated
# stack. That is right when you are working on the platform itself.
#
# An agent USING a dev stack must invoke the ON-PATH `loopany-dev` command
# instead: that stack is MANAGED and already running. Never source the env
# script, never start a server or daemon, never run a seed, never invent a port.
# Objects created on any stack other than the managed one land in a data dir the
# real environment never reads. If the managed stack is down: retry once after
# ~30s, then STOP and tell the human — a down stack is an operator matter.
# ============================================================================
#
# WHY THIS EXISTS. On a developer's machine plain `loopany` is the PRODUCTION
# binary: the PATH shim points at the installed daemon and `~/.loopany` holds a
# device credential for loopany.ai. Typing `loopany loop list` there does not read
# your dev kernel — it talks to production. This wrapper removes that foot-gun by
# construction: it runs THIS repo's CLI, with this repo's dev stack environment,
# and it REFUSES to run against a non-local server.
#
#   scripts/loopany-dev loop list
#   scripts/loopany-dev                       # the kernel home
#   scripts/loopany-dev loop run-now loop-…
#
# Environment: if LOOPANY_SERVER_URL is already set, it is honored (and checked);
# otherwise scripts/rewrite-local-run.env.sh is sourced to define the default
# isolated stack. Override LOOPANY_RW_BASE / LOOPANY_PORT before calling to point
# at a different local stack. Its banner goes to stderr, never stdout, so the
# CLI's TOON output stays machine-readable.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [ -z "${LOOPANY_SERVER_URL:-}" ]; then
  # shellcheck source=/dev/null
  source "$repo_root/scripts/rewrite-local-run.env.sh" 1>&2
fi

# THE GUARD, not a convention: a dev CLI that can reach production is a dev CLI
# that will, once. Only loopback hosts are allowed, and the refusal names what to
# do instead rather than silently falling back to something safe-looking.
case "${LOOPANY_SERVER_URL:-}" in
  http://127.0.0.1:*|http://localhost:*|http://[::1]:*|http://127.0.0.1|http://localhost) ;;
  *)
    echo "loopany-dev: refusing to run against '${LOOPANY_SERVER_URL:-<unset>}' — this CLI is for a LOCAL dev stack only." >&2
    echo "loopany-dev: unset LOOPANY_SERVER_URL to use this command's own configured stack." >&2
    echo "loopany-dev: do NOT stand up a stack to work around this — if your managed stack is unreachable, retry once after ~30s, then tell the human. (Working ON the platform itself? See scripts/rewrite-local-run.env.sh and packages/server/AGENTS.md.)" >&2
    exit 2
    ;;
esac

# Presentation only: bare `loopany-dev` renders the converged workspace home.
# Execution is the ordinary production poll path — there is no runtime switch,
# and this is the ONE marker the CLI reads.
export LOOPANY_DEV_HOME=1

exec "$repo_root/packages/daemon/node_modules/.bin/tsx" "$repo_root/packages/daemon/src/cli.ts" "$@"
